# dsh-bash-env ships no dependencies of its own: the host half is lib/index.js and
# the browser half is the hand-written lib/client.js. Everything ignored below is
# local tooling output or a transient test install.

# ── dependencies ────────────────────────────────────────────────────────────
# Created by `node scripts/link-host.mjs`, which symlinks the host packages the
# plugin imports. Those paths are machine-specific and point into ~/.dsh, so they
# must never be committed; run the script after cloning instead.
node_modules/
.pnpm-store/
.npm/

# Lockfiles: the package declares no dependencies, so there is nothing to pin.
# Remove these lines once a real dependency is added.
package-lock.json
pnpm-lock.yaml
yarn.lock

# ── test and tooling output ────────────────────────────────────────────────
coverage/
*.tsbuildinfo

# ── packing and logs ───────────────────────────────────────────────────────
*.tgz
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── editor and OS cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
