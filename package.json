{
  "name": "dsh-bash-env",
  "version": "0.1.0",
  "private": true,
  "description": "为 dsh 的每条 shell 命令按 workdir 计算环境：PATH 追加、venv 自动激活、禁用 mise 自动安装。Replaces the built-in bash executor so every `bash -c` gets an environment resolved from its own working directory.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./resolve": {
      "default": "./lib/resolve.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "link-host": "node scripts/link-host.mjs",
    "test": "node --test test/resolve.test.mjs test/client.smoke.mjs",
    "test:client": "node --test test/client.smoke.mjs",
    "test:unit": "node --test test/resolve.test.mjs",
    "test:integration": "node --test test/executor.integration.mjs",
    "test:all": "node --test test/resolve.test.mjs test/client.smoke.mjs test/executor.integration.mjs",
    "check": "node --check lib/index.js && node --check lib/resolve.js && node --check lib/client.js && node --check scripts/link-host.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shell",
    "bash",
    "venv",
    "mise"
  ],
  "license": "MIT"
}
